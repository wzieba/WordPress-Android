{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
		{
			"packagePatterns": ["*"],
			"enabled": false
		},
		{
      "matchPackagePatterns": ["^automattic"],
      "matchDepPatterns":["^automattic"],
			"enabled": true
		}
	]
}
