{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
		{
			"packagePatterns": ["*"],
			"enabled": false
		},
		{
      "matchDepPatterns":["automattic"],
			"enabled": true
		},
    {
      "enabledManagers": ["gradle"],
      "matchDepPatterns":["automattic"],
      "enabled": true,
      "versioning": "semver-coerced",
      "separateMultipleMajor": false
    }
	]
}
